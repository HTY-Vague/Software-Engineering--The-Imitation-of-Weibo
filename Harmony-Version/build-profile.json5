{
  "app": {
    // 不做签名：本项目仅在 API 26 模拟器上验证，DevEco 提示模拟器安装 HAP 可跳过签名。
    // 真机部署需要 profile（依赖设备 UDID），不在本次交付范围内；签名材料不进入仓库
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // 基线：HarmonyOS 26.0.0（API 26）
        "compileSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
