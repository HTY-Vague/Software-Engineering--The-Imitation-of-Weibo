<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.zut.softwareengineering.mapper.StatMapper">

    <!-- 统计概览快照 -->
    <resultMap id="OverviewMap" type="cn.edu.zut.softwareengineering.entity.StatOverview">
        <id column="id" property="id"/>
        <result column="user_count" property="userCount"/>
        <result column="active_user_count" property="activeUserCount"/>
        <result column="enabled_board_count" property="enabledBoardCount"/>
        <result column="post_count" property="postCount"/>
        <result column="comment_count" property="commentCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getOverview" resultMap="OverviewMap">
        SELECT id, user_count, active_user_count, enabled_board_count,
               post_count, comment_count, like_count, update_time
        FROM stat_overview
        WHERE id = 1
    </select>

    <!-- 热门帖子榜 -->
    <resultMap id="HotPostMap" type="cn.edu.zut.softwareengineering.entity.StatHotPost">
        <id column="rank_num" property="rankNum"/>
        <result column="post_id" property="postId"/>
        <result column="board_id" property="boardId"/>
        <result column="author_id" property="authorId"/>
        <result column="title" property="title"/>
        <result column="view_count" property="viewCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="comment_count" property="commentCount"/>
        <result column="hot_score" property="hotScore"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getHotPosts" resultMap="HotPostMap">
        SELECT rank_num, post_id, board_id, author_id, title,
               view_count, like_count, comment_count, hot_score, update_time
        FROM stat_hot_post
        ORDER BY rank_num ASC
        LIMIT #{limit}
    </select>

    <!-- 板块活跃度 -->
    <resultMap id="BoardActiveMap" type="cn.edu.zut.softwareengineering.entity.StatBoardActive">
        <id column="board_id" property="boardId"/>
        <result column="board_name" property="boardName"/>
        <result column="post_count" property="postCount"/>
        <result column="view_sum" property="viewSum"/>
        <result column="like_sum" property="likeSum"/>
        <result column="comment_sum" property="commentSum"/>
        <result column="active_score" property="activeScore"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getBoardActive" resultMap="BoardActiveMap">
        SELECT board_id, board_name, post_count, view_sum, like_sum, comment_sum, active_score, update_time
        FROM stat_board_active
        ORDER BY active_score DESC
    </select>

    <!-- 用户活跃度排行 -->
    <resultMap id="ActiveUserMap" type="cn.edu.zut.softwareengineering.entity.StatActiveUser">
        <id column="rank_num" property="rankNum"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickname"/>
        <result column="post_count" property="postCount"/>
        <result column="comment_count" property="commentCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="active_score" property="activeScore"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getActiveUsers" resultMap="ActiveUserMap">
        SELECT rank_num, user_id, username, nickname,
               post_count, comment_count, like_count, active_score, update_time
        FROM stat_active_user
        ORDER BY rank_num ASC
        LIMIT #{limit}
    </select>

    <!-- 内容质量分析 -->
    <resultMap id="ContentQualityMap" type="cn.edu.zut.softwareengineering.entity.StatContentQuality">
        <id column="post_id" property="postId"/>
        <result column="title" property="title"/>
        <result column="like_count" property="likeCount"/>
        <result column="comment_count" property="commentCount"/>
        <result column="view_count" property="viewCount"/>
        <result column="quality_type" property="qualityType"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getContentQuality" resultMap="ContentQualityMap">
        SELECT post_id, title, like_count, comment_count, view_count, quality_type, update_time
        FROM stat_content_quality
        <where>
            <if test="qualityType != null and qualityType != ''">
                AND quality_type = #{qualityType}
            </if>
        </where>
        ORDER BY quality_type, post_id
    </select>

    <!-- 每日趋势 -->
    <resultMap id="DailyTrendMap" type="cn.edu.zut.softwareengineering.entity.StatDailyTrend">
        <id column="stat_date" property="statDate"/>
        <result column="new_user_count" property="newUserCount"/>
        <result column="new_post_count" property="newPostCount"/>
        <result column="new_comment_count" property="newCommentCount"/>
        <result column="new_like_count" property="newLikeCount"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="getDailyTrend" resultMap="DailyTrendMap">
        SELECT stat_date, new_user_count, new_post_count, new_comment_count, new_like_count, update_time
        FROM stat_daily_trend
        ORDER BY stat_date DESC
        LIMIT #{days}
    </select>

    <select id="getLatestDailyTrend" resultMap="DailyTrendMap">
        SELECT stat_date, new_user_count, new_post_count, new_comment_count, new_like_count, update_time
        FROM stat_daily_trend
        ORDER BY stat_date DESC
        LIMIT 1
    </select>

</mapper>
